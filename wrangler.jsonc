{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Web de Cabañas Amanecer de Montaña en Cloudflare Workers (plan gratis).
  "name": "cabanas-amanecer-montana",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cabanas-amanecer-montana"
    }
  ],
  // Optimización de fotos (next/image) con Cloudflare Images.
  "images": {
    "binding": "IMAGES"
  },
  // Las variables se cargan en el panel de Cloudflare: que cada publicación no las borre.
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
