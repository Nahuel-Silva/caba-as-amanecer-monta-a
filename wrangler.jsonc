{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Web de Cabañas Amanecer de Montaña en Cloudflare Workers (plan gratis).
  "name": "cabanas-amanecer-montana",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cabanas-amanecer-montana"
    }
  ],
  // Base de datos Cloudflare D1. DATABASE_PROVIDER=d1 hace que la web la use en lugar de Turso (src/lib/db.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cabanas-amanecer",
      "database_id": "d98ecc51-0923-4c4c-9ddd-644dfb16541b"
    }
  ],
  "vars": {
    "DATABASE_PROVIDER": "d1"
  },
  // Optimización de fotos (next/image) con Cloudflare Images.
  "images": {
    "binding": "IMAGES"
  },
  // Las variables se cargan en el panel de Cloudflare: que cada publicación no las borre.
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
