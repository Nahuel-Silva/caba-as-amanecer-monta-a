# Copiá este archivo como .env.local (desarrollo) y cargá el valor real.
# En producción (Cloudflare): las NEXT_PUBLIC_ van como variables de compilación y el resto como secretos
# del Worker (ver "Publicación en Cloudflare" en README.md). La base de datos (Cloudflare D1) no necesita variables.
#
# Número de WhatsApp con código de país y sin "+", espacios ni guiones.
# Ejemplo de formato (NO es un número real): 549XXXXXXXXXX
# Si queda vacío, los botones de WhatsApp no se muestran.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Teléfonos para reservar por llamada (botón con un teléfono al lado de Instagram).
# Entradas separadas por ";", cada una "Nombre | número". El nombre es opcional.
# Ejemplo de formato (NO son números reales): Nahuel | +54 9 260 400-0000; María | +54 9 260 400-0001
# Si queda vacío, el botón de llamada no se muestra.
NEXT_PUBLIC_PHONE_NUMBERS=

# URL pública del sitio, con https y sin barra final. Ejemplo (NO es real): https://www.ejemplo.com
# IMPORTANTE: mientras esté vacía, el sitio se declara NO indexable (noindex, robots.txt bloquea todo
# y no se publica sitemap), para que Google no indexe una versión con datos pendientes.
# Cargala en producción recién cuando el contenido real esté listo.
NEXT_PUBLIC_SITE_URL=

# Envío de solicitudes de reserva por mail con Resend (https://resend.com). Son variables de servidor:
# nunca agregarles el prefijo NEXT_PUBLIC_. Sin estas variables no se envían mails, pero las solicitudes se guardan en la base.
RESEND_API_KEY=
# Casilla donde llegan las solicitudes.
RESERVATIONS_EMAIL_TO=
# Remitente, de un dominio verificado en Resend. Ejemplo: Cabañas Amanecer de Montaña <reservas@ejemplo.com>
# Con este remitente también salen los mails a huéspedes desde el panel (seña y confirmación); sus respuestas
# llegan a RESERVATIONS_EMAIL_TO. Sin dominio verificado, Resend solo entrega mails al dueño de la cuenta.
RESERVATIONS_EMAIL_FROM=

# Contraseña del panel /admin, de al menos 12 caracteres. Cambiala para cerrar todas las sesiones.
ADMIN_PASSWORD=

# Traducción automática con DeepL (https://www.deepl.com/pro-api, plan gratis). Opcional: sin la clave, las promociones
# y los mensajes que se escriben en el panel quedan en español en las versiones en portugués e inglés.
DEEPL_API_KEY=
