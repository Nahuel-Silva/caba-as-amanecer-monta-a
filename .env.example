# Copiá este archivo como .env.local (desarrollo) y cargá el valor real.
# En producción (Vercel): Project Settings > Environment Variables.
#
# Número de WhatsApp con código de país y sin "+", espacios ni guiones.
# Ejemplo de formato (NO es un número real): 549XXXXXXXXXX
# Si queda vacío, los botones de WhatsApp no se muestran.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública del sitio, con https y sin barra final. Ejemplo (NO es real): https://www.ejemplo.com
# IMPORTANTE: mientras esté vacía, el sitio se declara NO indexable (noindex, robots.txt bloquea todo
# y no se publica sitemap), para que Google no indexe una versión con datos pendientes.
# Cargala en producción recién cuando el contenido real esté listo.
NEXT_PUBLIC_SITE_URL=

# Envío de solicitudes de reserva por mail con Resend (https://resend.com). Son variables de servidor:
# nunca agregarles el prefijo NEXT_PUBLIC_. Si falta alguna, en producción el ícono de mail no se muestra.
RESEND_API_KEY=
# Casilla donde llegan las solicitudes.
RESERVATIONS_EMAIL_TO=
# Remitente, de un dominio verificado en Resend. Ejemplo: Cabañas Amanecer de Montaña <reservas@ejemplo.com>
RESERVATIONS_EMAIL_FROM=
